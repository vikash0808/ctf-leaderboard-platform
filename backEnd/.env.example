# Backend Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URI=http://localhost:3000

# MongoDB Connection
MONGODB_CONNSTRING=mongodb://127.0.0.1:27017/ctf_leaderboard
MONGODB_AUTH_SOURCE=admin

# Session Security (replace with a long random string in production)
SESSION_SECRET=replace-with-a-strong-random-secret
COOKIE_SECURE=false

# Optional SMTP / Email Verification
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
